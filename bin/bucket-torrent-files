#!/usr/bin/env bash

verbose=0

# Parse command line options
while getopts "v" opt; do
  case "$opt" in
    v) verbose=1 ;;
    *) echo "Usage: $0 [-v]" >&2; exit 1 ;;
  esac
done

shopt -s nullglob

for f in *.torrent; do
    date=$(date +%F -r "$f")
    y=${date:0:4}
    m=${date:5:2}
    d=${date:8:2}
    target="$y/$m/$d"

    mkdir -p "$target"

    if [ "$verbose" -eq 1 ]; then
      echo "Moving '$f' -> '$target/'"
    fi
    mv "$f" "$target"
done

