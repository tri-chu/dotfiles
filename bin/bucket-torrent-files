#!/usr/bin/env bash

perl -e '
use File::Path qw(make_path);
use File::Copy qw(move);
use POSIX qw(strftime);

my $verbose = grep { $_ eq "-v" } @ARGV;

for my $f (<*.torrent>) {
    next unless -f $f;
    my @st = stat($f);
    my $target = strftime("%Y/%m/%d", localtime($st[9]));
    
    make_path($target);
    print "Moving '\''$f'\'' -> '\''$target/'\''\n" if $verbose;
    move($f, "$target/$f");
}
' -- "$@"
