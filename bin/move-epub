#!/usr/bin/env bash

set -euo pipefail

# 1. Check if target directory argument is provided
if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <target_directory>"
    exit 1
fi

TARGET_DIR="$1"

# 2. Create the target directory if it doesn't already exist
mkdir -p "$TARGET_DIR"

# Resolve absolute path for the target directory to avoid self-moving issues
TARGET_DIR_ABS=$(cd "$TARGET_DIR" && pwd)

echo "Searching for directories containing .epub files..."

# 3. Find all distinct parent directories of .epub files
# -type f -iname "*.epub": Find files ending in .epub (case-insensitive)
# -print0 / read -d '': Handle directory names with spaces or special characters safely
find . -type f -iname "*.epub" -print0 | while IFS= read -r -d '' file; do
    dir=$(dirname "$file")
    
    # Resolve absolute path of directory containing .epub
    dir_abs=$(cd "$dir" && pwd)
    
    # Skip if directory is inside target destination
    if [[ "$dir_abs" == "$TARGET_DIR_ABS"* ]]; then
        continue
    fi
    
    echo "$dir_abs"
done | sort -u | while read -r dir_to_move; do
    echo "Syncing and overwriting: '$dir_to_move' -> '$TARGET_DIR_ABS/'"
    
    # rsync flags:
    # -a: archive mode (preserves permissions, timestamps, symlinks, etc.)
    # --remove-source-files: deletes source files after successful copy
    rsync -a --remove-source-files "$dir_to_move" "$TARGET_DIR_ABS/"
    
    # Clean up empty source directories left behind by --remove-source-files
    find "$dir_to_move" -type d -empty -delete 2>/dev/null || true
done

echo "Done!"