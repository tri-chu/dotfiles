#!/usr/bin/env bash

set -euo pipefail

PRESERVE_TIME=false
TARGET_DIR=""

# Parse flags vs arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t|--time)
      PRESERVE_TIME=true
      shift
      ;;
    *)
      TARGET_DIR="$1"
      shift
      ;;
  esac
done

if [ -z "$TARGET_DIR" ]; then
    echo "Usage: $0 [-t|--time] <target_directory>"
    exit 1
fi

# Create target directory if it doesn't exist
mkdir -p "$TARGET_DIR"

# Resolve absolute path for target directory
TARGET_DIR_ABS=$(cd "$TARGET_DIR" && pwd)

# Base rsync options:
# -r: recursive
# -l: copy symlinks as symlinks
# -p: preserve permissions
# -g: preserve group
# -o: preserve owner
# (Notice -t / modification times is excluded by default)
RSYNC_FLAGS="-rlpo --remove-source-files"

if [ "$PRESERVE_TIME" = true ]; then
    echo "Time preservation enabled."
    RSYNC_FLAGS="$RSYNC_FLAGS -t"
else
    echo "Time preservation disabled (default)."
    # --no-t explicitly tells rsync not to set modification times
    RSYNC_FLAGS="$RSYNC_FLAGS --no-t"
fi

echo "Searching for directories containing .epub files..."

# 3. Find all distinct parent directories of .epub files
# -type f -iname "*.epub": Find files ending in .epub (case-insensitive)
# -print0 / read -d '': Handle directory names with spaces or special characters safely
find . -type f -iname "*.epub" -print0 | while IFS= read -r -d '' file; do
    dir=$(dirname "$file")
    
    # Resolve absolute path of directory containing .epub
    dir_abs=$(cd "$dir" && pwd)
    
    # Skip if directory is inside target destination
    if [[ "$dir_abs" == "$TARGET_DIR_ABS"* ]]; then
        continue
    fi
    
    echo "$dir_abs"
done | sort -u | while read -r dir_to_move; do
    echo "Syncing and overwriting: '$dir_to_move' -> '$TARGET_DIR_ABS/'"
    
    # Run rsync without failing on time modification
    rsync $RSYNC_FLAGS "$dir_to_move" "$TARGET_DIR_ABS/"
    
    # Clean up empty source directories left behind
    find "$dir_to_move" -type d -empty -delete 2>/dev/null || true
done

echo "Done!"